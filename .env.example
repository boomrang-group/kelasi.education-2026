# ==========================================
# CONFIGURATION DE L'APPLICATION
# ==========================================
APP_NAME="MyKelasi"
APP_ENV=local               # local | production
APP_URL=http://localhost/mykelasi
APP_TIMEZONE=Africa/Kinshasa

# ==========================================
# BASE DE DONNEES (MySQL / MariaDB)
# ==========================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kelasi_db
DB_USER=root
DB_PASS=

# ==========================================
# CONFIGURATION EMAIL / SMTP
# ==========================================
# Utilisé si vous passez par un SMTP distant (PHPMailer / SwiftMailer)
MAIL_DRIVER=smtp            # smtp | sendmail | mail
MAIL_HOST=mail.kelasi.education
MAIL_PORT=465
MAIL_USERNAME=no-reply@kelasi.education
MAIL_PASSWORD=votre_mot_de_passe_ici
MAIL_ENCRYPTION=ssl         # ssl | tls | null

# Informations d'expédition par défaut
MAIL_FROM_ADDRESS=no-reply@kelasi.education
MAIL_FROM_NAME="MyKelasi"

# ==========================================
# LIENS DE REDIRECTION ET ACCÈS
# ==========================================
URL_SCHOOL_ACCESS=https://kelasi.education/mykelasi/my_school/
URL_LOGIN=https://kelasi.education/mykelasi/my_school/